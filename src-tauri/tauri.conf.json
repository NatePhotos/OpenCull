{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCull",
  "version": "0.5.0",
  "identifier": "org.opencull.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCull",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#14141a",
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' opencull: http://opencull.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'self' asset: http://asset.localhost http://127.0.0.1:* blob:"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright \u00a9 2026 The OpenCull authors. Free software under the GNU General Public License, version 3 or later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NUIzODREQTUyNjcyQzcKUldUSGNpYWxUVGhicFJmbzdWMzlzNDhrOUwwYmNUWWRRT2xkeGJrb1I5Qms3bkRyb256QW9XeGQK",
      "endpoints": [
        "https://github.com/wispdevon/OpenCull/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
