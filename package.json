{
  "name": "opencull",
  "private": true,
  "version": "0.5.0",
  "license": "GPL-3.0-or-later",
  "repository": "github:NatePhotos/OpenCull",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-node.mjs && vite",
    "desktop": "node scripts/dev-desktop.mjs",
    "build": "npm run build:web",
    "build:web": "node scripts/check-node.mjs && tsc && tsc -p tsconfig.node.json && vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test": "npm run test:web && npm run test:rust",
    "test:web": "node scripts/check-node.mjs && node --test scripts/cuda-desktop.test.mjs scripts/dev-desktop.test.mjs && vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check": "npm test && npm run build:web",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.21.1"
}
